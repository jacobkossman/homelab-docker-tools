# Copy to .env (chmod 600 .env). Values are filled into updates2mqtt.yml by compose.
HOST_NAME=media
DOCKER_DIR=/home/alice/docker
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=updates2mqtt
MQTT_PASS=change-me
# optional: lets you run plain `docker compose up -d` in this folder
COMPOSE_FILE=updates2mqtt.yml
