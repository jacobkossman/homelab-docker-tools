# /etc/pbs-docker-backup.env — root:root, chmod 600
BASE=/home/alice/docker
PBS_REPOSITORY='backup@pbs!docker@pbs.lan:8007:datastore'
PBS_PASSWORD='00000000-0000-0000-0000-000000000000'
PBS_FINGERPRINT='aa:bb:cc:...'

# optional
#PBS_NAMESPACE=docker
#HOST_NAME=media
#EXCLUDES="recordings clips transcodes cache logs MediaCover"

# optional: status sensors + failure events in Home Assistant (apt install mosquitto-clients)
#MQTT_HOST=homeassistant.local
#MQTT_PORT=1883
#MQTT_USER=updates2mqtt
#MQTT_PASS='change-me'
